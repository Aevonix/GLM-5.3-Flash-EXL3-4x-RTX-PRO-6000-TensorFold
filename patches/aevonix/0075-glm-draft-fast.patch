+            self.f_meta.copy_(self.f_host, non_blocking=True)
+            if self.f_ready is not None:
+                self.f_ready.record()
+            return k
+
+        def _run(self, S: int) -> None:
+            g = self.block_graphs.get(S)
+            if g is not None:
+                g.replay()
+            else:
+                self._block_compute(S)
