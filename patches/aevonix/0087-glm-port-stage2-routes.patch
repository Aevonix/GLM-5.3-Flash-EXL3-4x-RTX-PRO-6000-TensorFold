+                if r.numel():
                     self._check(x.ncclRecv(r.data_ptr(), r.numel(), _DTYPES[r.dtype], peer, xc, stream), x)
         finally:
             self._check(x.ncclGroupEnd(), x)
diff --git tensorfold/cuda/incremental.py tensorfold/cuda/incremental.py
