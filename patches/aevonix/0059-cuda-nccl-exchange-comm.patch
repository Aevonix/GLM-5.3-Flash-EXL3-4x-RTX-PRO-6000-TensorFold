 """NCCL all-gather (and paired send/receive) on the current stream so CUDA graphs capture it; a rank-order sum after
-it keeps ranks bit-equal."""
+it keeps ranks bit-equal.
+
+TF_NCCL_EXCHANGE_ENV (optional, e.g. ``NCCL_P2P_DISABLE=1``): the paired sends and receives (``exchange``,
+``exchange_all``: the row-split prompt chunks' swaps) go through a second NCCL communicator, created from a second
+copy of the library with these NCCL_* settings (space separated) in effect for it alone. NCCL reads its settings once a
+process, so one library cannot run its all-gathers over one transport and its sends over another; on PCIe hosts where
+NCCL's peer-to-peer all-gathers are fast but its peer-to-peer send/receive path is slow (two channels a peer), this keeps
+every collective on peer-to-peer and the bulk swaps on shared memory. The same bytes move in the same order."""
 
 from __future__ import annotations
 
@@ -51,6 +58,68 @@ def _library() -> ctypes.CDLL:
     raise RuntimeError("libnccl not found (set TF_NCCL_LIB)")
 
 
+def _loaded_path(name: str = "libnccl.so") -> str | None:
+    """The file of the loaded library named ``name``* (libnccl.so, libnccl.so.2, ...; not NCCL's plugins such as
+    libnccl-net-*.so) in this process's memory map, or None."""
+
+    try:
+        with open("/proc/self/maps") as f:
+            for line in f:
+                path = line.split()[-1] if line.strip() else ""
+                if os.path.basename(path).startswith(name):
+                    return path
+    except OSError:
+        pass
+    return None
+
+
+def _second_library(lib: ctypes.CDLL) -> ctypes.CDLL:
+    """A second, independent instance of the loaded NCCL library (a private copy of its file, mapped on its own, so it
+    keeps its own once-a-process settings); the copy is unlinked once mapped."""
+
+    import shutil
+    import tempfile
+
+    src = _loaded_path() or getattr(lib, "_name", "")
+    if not src or not os.path.exists(src):
+        raise RuntimeError("TF_NCCL_EXCHANGE_ENV: cannot find the loaded NCCL library's file to copy")
+    tmp = tempfile.mkdtemp(prefix="tf-nccl-exchange-")
+    dst = os.path.join(tmp, "libnccl-exchange.so.2")
+    shutil.copy2(os.path.realpath(src), dst)
+    try:
+        return ctypes.CDLL(dst, mode=getattr(os, "RTLD_LOCAL", 0) | getattr(os, "RTLD_NOW", 2))
+    finally:
+        os.unlink(dst)
+        os.rmdir(tmp)
+
+
+def exchange_env(value: str | None = None) -> dict[str, str]:
+    """TF_NCCL_EXCHANGE_ENV: NCCL_* settings (space separated NAME=VALUE) for the send/receive communicator; empty: off."""
+
+    value = (os.environ.get("TF_NCCL_EXCHANGE_ENV", "") if value is None else value).strip()
+    out: dict[str, str] = {}
+    for item in value.split():
+        name, eq, setting = item.partition("=")
+        if not eq or not name.startswith("NCCL_") or not name.replace("_", "").isalnum():
+            raise ValueError(f"TF_NCCL_EXCHANGE_ENV: NCCL_NAME=value items separated by spaces, not {item!r}")
+        out[name] = setting
+    return out
+
+
+def _bind(lib: ctypes.CDLL) -> None:
+    lib.ncclGetErrorString.restype = ctypes.c_char_p
+    lib.ncclGetErrorString.argtypes = [ctypes.c_int]
+    lib.ncclGetUniqueId.argtypes = [ctypes.POINTER(_UniqueId)]
+    lib.ncclCommInitRank.argtypes = [ctypes.POINTER(ctypes.c_void_p), ctypes.c_int, _UniqueId, ctypes.c_int]
+    lib.ncclAllGather.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int, ctypes.c_void_p,
+                                  ctypes.c_void_p]
+    for name in ("ncclSend", "ncclRecv"):
+        getattr(lib, name).argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int, ctypes.c_int,
+                                       ctypes.c_void_p, ctypes.c_void_p]
+    lib.ncclGroupStart.argtypes = []
+    lib.ncclGroupEnd.argtypes = []
+
