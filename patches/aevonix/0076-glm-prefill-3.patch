+    visible = (P + gl.minimum(r0 + RB, R)) // 4           # pools the program's last row sees
+    first = (P + r0 + 1) // 4                              # pools its first row sees
+    kmax = (P + r0 + RB) // 4                              # _scores' key mask (rb * RB + RB)
+    nblk = (NP + BP - 1) // BP
