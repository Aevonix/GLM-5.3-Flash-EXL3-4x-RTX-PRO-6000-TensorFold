+        for fused in (False, True):
+            oa = torch.empty((R, qa), dtype=bf, device=device)
+            ob = torch.empty((R, kb), dtype=bf, device=device)
+            xa = torch.empty((R, qa // 64), dtype=torch.float32, device=device)
