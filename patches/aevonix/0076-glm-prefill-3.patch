+    gen = torch.Generator(device=device).manual_seed(194)
+    bf = torch.bfloat16
+    for R in (1, 7, 64, 513):
+        dp = _wide((R, qa + kb), gen, device, 6).to(bf)
+        wa = _wide((qa,), gen, device, 3).to(bf)
+        wb = _wide((kb,), gen, device, 3).to(bf)
