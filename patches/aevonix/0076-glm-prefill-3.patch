+def _wide(shape, gen, device, spread: int) -> torch.Tensor:
+    e = torch.randint(-spread, spread + 1, shape, device=device, generator=gen).to(torch.float32)
+    return torch.randn(shape, device=device, generator=gen) * torch.exp2(e)
