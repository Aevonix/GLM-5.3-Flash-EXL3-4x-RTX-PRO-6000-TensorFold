+        ln_w = _wide((128,), gen, device, 2).to(bf)
+        ln_b = _wide((128,), gen, device, 2).to(bf)
+        ape = _wide((4, 128), gen, device, 2).to(bf)
+        ik0 = _wide((8 * ring, 128), gen, device, 4).to(bf)
+        ig0 = _wide((8 * ring, 128), gen, device, 4).to(bf)
