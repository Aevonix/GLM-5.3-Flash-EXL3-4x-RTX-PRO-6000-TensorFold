+EXL3_ROUTES = ("auto", "glm", "universal")
+
+
+def exl3_route_setting(env=None) -> str:
+    """TF_GLM_EXL3_PATH: which kernels serve an EXL3 checkpoint's routed experts. ``auto`` (default): GLM's own
+    (``exl3_mm``: 4-bit mcg trellises, the kernels the GLM patches tune) when every routed expert of the checkpoint is
+    one, else TensorFold's universal path (``tensorfold.cuda.exl3.experts``: any width a matrix, any codebook);
+    ``glm``: GLM's own, refusing a checkpoint they cannot read; ``universal``: the universal path for every one."""
+
+    value = ((os.environ if env is None else env).get("TF_GLM_EXL3_PATH", "") or "auto").strip().lower()
+    if value not in EXL3_ROUTES:
+        raise ValueError(f"TF_GLM_EXL3_PATH: {', '.join(EXL3_ROUTES)}, not {value!r}")
+    return value
+
+
+def routed_trellises(cfg: Config, mtp: bool = True) -> list[str]:
+    """The checkpoint names of every routed expert trellis (MoE layers, then the MTP layer's)."""
+
+    layers = [i for i in range(cfg.layers) if cfg.mlp_kinds[i] == "moe"]
+    if mtp and cfg.mtp_layers:
+        layers.append(cfg.layers)
+    return [PREFIX + f"layers.{i}.mlp.experts.{e}.{proj}.trellis" for i in layers
+            for proj in ("gate_proj", "up_proj", "down_proj") for e in range(cfg.experts)]
+
+
+def dedicated_reads(stored: list[tuple[str, list[int]]], codebook: str) -> bool:
+    """Whether GLM's own EXL3 kernels read every trellis: (safetensors dtype, shape) pairs, 4-bit mcg only (int16
+    [..., 64]: 16 values of 4 bits a 64-bit word pair, the layout ``exl3_mm.words`` takes)."""
+
+    return codebook == "mcg" and bool(stored) and all(dtype == "I16" and shape and shape[-1] == 64
+                                                     for dtype, shape in stored)
+
+
+@lru_cache(maxsize=8)
+def exl3_route(model_dir: str, rank: int, world: int) -> str:
+    """``glm`` or ``universal`` (TF_GLM_EXL3_PATH, ``exl3_route_setting``) for an EXL3 checkpoint on ``rank``: read
+    from the safetensors headers alone (every routed trellis' dtype and last dimension) and the config's codebook.
+    The startup estimate and the loader ask the same question, so they size the same scratch."""
+
+    from .split import rank_files, read_header
+
+    want = exl3_route_setting()
+    if want == "universal":
+        return "universal"
+    cfg = Config.read(model_dir)
+    names = routed_trellises(cfg)
+    root = Path(model_dir)
+    files = rank_files(root, rank)
+    headers: dict[str, dict] = {}
+    if files:                                   # a pre-split rank folder: its own files' headers
+        where = {}
+        for f in files:
+            header = read_header(f)[0]
+            headers[str(f)] = header
+            where.update(dict.fromkeys((k for k in header if k != "__metadata__"), str(f)))
+    else:
+        index = root / "model.safetensors.index.json"
+        if index.exists():
+            where = {k: str(root / v) for k, v in json.loads(index.read_text())["weight_map"].items()}
+        else:
+            where = {}
+            for f in sorted(root.glob("*.safetensors")):
+                headers[str(f)] = read_header(f)[0]
+                where.update(dict.fromkeys((k for k in headers[str(f)] if k != "__metadata__"), str(f)))
+    stored = []
+    for name in names:
+        f = where.get(name)
+        if f is None:                           # e.g. no MTP layer in this checkpoint
+            continue
+        if f not in headers:
+            headers[f] = read_header(f)[0]
+        info = headers[f][name]
+        stored.append((str(info["dtype"]), list(info["shape"])))
+    widths = sorted({shape[-1] / 16 for _, shape in stored if shape})
+    if dedicated_reads(stored, cfg.codebook):
+        route = "glm"
+    elif want == "glm":
+        raise ValueError(f"TF_GLM_EXL3_PATH=glm: GLM's own EXL3 expert kernels read 4-bit mcg trellises only; this "
+                         f"checkpoint's routed experts are {cfg.codebook} at {widths} bits (TF_GLM_EXL3_PATH=auto "
+                         "serves them on the universal path)")
+    else:
+        route = "universal"
+    if rank == 0:
+        print(f"[tensorfold] EXL3 routed experts ({cfg.codebook}, {', '.join(f'{b:g}' for b in widths)} bits): "
+              + ("GLM's own kernels" if route == "glm" else "the universal route") + f" (TF_GLM_EXL3_PATH={want})",
+              flush=True)
+    return route
+
